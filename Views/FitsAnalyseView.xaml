<UserControl
    x:Class="FitsAnalyse.Views.FitsAnalyseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FitsAnalyse.Views"
    MinWidth="300"
    Foreground="#E8E8E8"
    TextElement.Foreground="#E8E8E8">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="FA_BoolToVis" />

        <!--  Texte en blanc partout dans le panneau, quel que soit le style du thème de NINA  -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <!--  Bouton à icône  -->
        <Style x:Key="FA_Icon" TargetType="ButtonBase">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="#2B2B2B" BorderBrush="#404040" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Interrupteur à icône (enfoncé = fond bleu)  -->
        <Style x:Key="FA_IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#2B2B2B" BorderBrush="#404040" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E5470" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FA3D1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Canal R, V ou B : pastille de couleur, pleine si le canal est affiché, cerclée sinon  -->
        <Style x:Key="FA_ChannelToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse
                                x:Name="Dot"
                                Width="18"
                                Height="18"
                                Fill="Transparent"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <!--  en mode Mono : simple cercle, un clic passe en RVB  -->
                            <DataTrigger Binding="{Binding ShowColorCurves}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FA_Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Image analysée  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock FontWeight="SemiBold" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />
            <TextBlock FontSize="11" Opacity="0.7" Text="{Binding DetailText}" TextWrapping="Wrap" />
        </StackPanel>

        <!--  Statistiques (mêmes valeurs que le panneau Statistiques de NINA, par canal en couleur)  -->
        <Grid Grid.Row="1" Margin="0,0,0,6" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FA_Label" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FA_L" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FA_R" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FA_G" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FA_B" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource FA_Cell}" Text="Valeur"
                           Visibility="{Binding IsMonoMode, Converter={StaticResource FA_BoolToVis}}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="#F05050" Style="{StaticResource FA_Cell}" Text="R"
                           Visibility="{Binding ShowColorCurves, Converter={StaticResource FA_BoolToVis}}" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="#50D050" Style="{StaticResource FA_Cell}" Text="V"
                           Visibility="{Binding ShowColorCurves, Converter={StaticResource FA_BoolToVis}}" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="#509AFF" Style="{StaticResource FA_Cell}" Text="B"
                           Visibility="{Binding ShowColorCurves, Converter={StaticResource FA_BoolToVis}}" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding StatRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FA_Label" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FA_L" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FA_R" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FA_G" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FA_B" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" Opacity="0.8" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FA_Cell}" Text="{Binding L}"
                                       Visibility="{Binding DataContext.IsMonoMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource FA_BoolToVis}}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource FA_Cell}" Text="{Binding R}"
                                       Visibility="{Binding DataContext.ShowColorCurves, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource FA_BoolToVis}}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource FA_Cell}" Text="{Binding G}"
                                       Visibility="{Binding DataContext.ShowColorCurves, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource FA_BoolToVis}}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource FA_Cell}" Text="{Binding B}"
                                       Visibility="{Binding DataContext.ShowColorCurves, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource FA_BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  Temps de pose conseillé  -->
        <Border Grid.Row="2" Margin="0,0,0,6" Padding="6,4" BorderBrush="{Binding VerdictBrush}" BorderThickness="3,0,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{Binding VerdictBrush}" Text="{Binding AdviceTitle}" TextWrapping="Wrap" />
                <TextBlock FontSize="11" Text="{Binding AdviceText}" TextWrapping="Wrap" />
                <TextBlock FontSize="10" Opacity="0.6" Text="{Binding AdviceDetail}" TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding MeasureBiasCommand}"
                    Content="Mesurer un bias…"
                    MinWidth="28" Height="24" Margin="0,0,3,3" Padding="6,0" FontSize="11" VerticalContentAlignment="Center"
                    ToolTip="Choisir un ou deux bias (mêmes gain, offset et mode de lecture) pour mesurer le bruit de lecture"
                    Visibility="{Binding NeedsReadNoise, Converter={StaticResource FA_BoolToVis}}" />
            </StackPanel>
        </Border>

        <!--  Barre d'outils : affichage de l'histogramme, puis réglage de l'image de l'onglet Image  -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,2" Orientation="Horizontal">
            <RadioButton GroupName="FA_Mode" IsChecked="{Binding IsMonoMode, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                         ToolTip="Mono : un seul histogramme, tous les pixels">
                <Path Width="16" Height="16" Data="M1,14 C4,14 5,3 8,3 C11,3 12,14 15,14 Z" Fill="#D8D8D8" />
            </RadioButton>
            <RadioButton GroupName="FA_Mode" IsChecked="{Binding IsRgbMode, Mode=TwoWay}" IsEnabled="{Binding IsColorImage}"
                         Style="{StaticResource FA_IconToggle}" ToolTip="RVB : canaux rouge, vert et bleu séparés (caméra couleur)">
                <Canvas Width="16" Height="16">
                    <Ellipse Canvas.Left="4" Canvas.Top="0" Width="8" Height="8" Fill="#F05050" />
                    <Ellipse Canvas.Left="0" Canvas.Top="7" Width="8" Height="8" Fill="#50D050" />
                    <Ellipse Canvas.Left="8" Canvas.Top="7" Width="8" Height="8" Fill="#509AFF" />
                </Canvas>
            </RadioButton>
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <RadioButton GroupName="FA_Scale" IsChecked="{Binding LinearScale, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                         ToolTip="Échelle verticale linéaire">
                <Path Width="16" Height="16" Data="M1,1 V15 H15 M3.5,12.5 L14,2" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </RadioButton>
            <RadioButton GroupName="FA_Scale" IsChecked="{Binding LogScale, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                         ToolTip="Échelle verticale logarithmique">
                <Path Width="16" Height="16" Data="M1,1 V15 H15 M3.5,12.5 C3.5,6 6,3 14,3" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </RadioButton>
            <ToggleButton IsChecked="{Binding Smooth, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                          ToolTip="Lisser les queues de l'histogramme (affichage seulement ; les valeurs au clic restent brutes)">
                <Path Width="16" Height="16" Data="M1,11 C4,3 7,3 8,8 C9,13 12,13 15,5" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </ToggleButton>
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <ToggleButton BorderBrush="#F05050" IsChecked="{Binding ShowR, Mode=TwoWay}" Style="{StaticResource FA_ChannelToggle}" ToolTip="Afficher le canal rouge" />
            <ToggleButton BorderBrush="#50D050" IsChecked="{Binding ShowG, Mode=TwoWay}" Style="{StaticResource FA_ChannelToggle}" ToolTip="Afficher le canal vert" />
            <ToggleButton BorderBrush="#509AFF" IsChecked="{Binding ShowB, Mode=TwoWay}" Style="{StaticResource FA_ChannelToggle}" ToolTip="Afficher le canal bleu" />
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource FA_Icon}" ToolTip="Dézoomer (ou molette)">
                <Path Width="16" Height="16" Data="M6.5,1.5 A5,5 0 1 1 6.49,1.5 M10.2,10.2 L14.5,14.5 M4,6.5 H9" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button Command="{Binding ZoomInCommand}" Style="{StaticResource FA_Icon}" ToolTip="Zoomer (ou molette)">
                <Path Width="16" Height="16" Data="M6.5,1.5 A5,5 0 1 1 6.49,1.5 M10.2,10.2 L14.5,14.5 M4,6.5 H9 M6.5,4 V9" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource FA_Icon}" ToolTip="Toute la plage (ou double clic)">
                <Path Width="16" Height="16" Data="M1,8 L5,4 V7 H11 V4 L15,8 L11,12 V9 H5 V12 Z" Fill="#E8E8E8" />
            </Button>
            <Button Command="{Binding AutoFrameCommand}" Style="{StaticResource FA_Icon}" ToolTip="Cadrer sur toute la dynamique des canaux affichés">
                <Grid Width="16" Height="16">
                    <Path Width="16" Height="16" Data="M4,2 H1 V14 H4 M12,2 H15 V14 H12" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Width="16" Height="16" Data="M4,13 C6,13 7,5 8,5 C9,5 10,13 12,13 Z" Fill="#E8E8E8" />
                </Grid>
            </Button>
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <ToggleButton IsChecked="{Binding IsAutoStretch, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                          ToolTip="Autostretch de l'image (comme le bouton de l'onglet Image), appliqué à chaque nouvelle image">
                <Path Width="16" Height="16" Data="M2,14 L10,6 M12,1 V5 M10,3 H14 M14,7 V10 M12.5,8.5 H15.5 M5,1.5 V4.5 M3.5,3 H6.5" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding ShowOutput, Mode=TwoWay}" Style="{StaticResource FA_IconToggle}"
                          ToolTip="Afficher au-dessus l'histogramme de l'image étirée, mis à jour en direct quand on déplace les curseurs">
                <Canvas Width="16" Height="16">
                    <Path Data="M1,6.5 C3,6.5 4,1 6,1 C8,1 9,6.5 15,6.5 Z" Fill="#E8E8E8" />
                    <Path Data="M1,15 C4,15 5,9 8,9 C11,9 12,15 15,15 Z" Fill="#8A8A8A" />
                </Canvas>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsUnlinked, Mode=TwoWay}" IsEnabled="{Binding IsColorImage}" Style="{StaticResource FA_IconToggle}"
                          ToolTip="Étirement séparé par canal (enfoncé) ou lié (relâché). En séparé, les curseurs règlent les canaux affichés en mode RVB : affiche un seul canal pour régler sa courbe">
                <Canvas Width="16" Height="16">
                    <Path Data="M7,4 L8.5,2.5 A3,3 0 0 1 13.5,7.5 L12,9" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M9,12 L7.5,13.5 A3,3 0 0 1 2.5,8.5 L4,7" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M1.5,1.5 L4,4" Stroke="#F05050" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M12,12 L14.5,14.5" Stroke="#509AFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsAutoWB, Mode=TwoWay}" IsEnabled="{Binding IsColorImage}" Style="{StaticResource FA_IconToggle}"
                          ToolTip="Balance des blancs automatique : aligne les canaux R, V, B (images couleur)">
                <Canvas Width="16" Height="16">
                    <Path Canvas.Left="-1" Data="M1,14 C4,14 5,3 8,3 C11,3 12,14 15,14" Stroke="#F05050" StrokeThickness="1.4" />
                    <Path Canvas.Left="1" Data="M1,14 C4,14 5,3 8,3 C11,3 12,14 15,14" Stroke="#509AFF" StrokeThickness="1.4" />
                    <Path Canvas.Left="0" Data="M1,14 C4,14 5,3 8,3 C11,3 12,14 15,14" Stroke="#50D050" StrokeThickness="1.4" />
                </Canvas>
            </ToggleButton>
            <Button Command="{Binding ResetImageCommand}" Style="{StaticResource FA_Icon}" ToolTip="Revenir à l'image d'origine (sans étirement ni balance des blancs)">
                <Path Width="16" Height="16" Data="M13.5,8 A5.5,5.5 0 1 1 11,3.4 M8.5,0.8 L11.6,3.2 L9,6.2" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <Button Command="{Binding SaveReferenceCommand}" Style="{StaticResource FA_Icon}" ToolTip="Mémoriser cet histogramme en gris pour le comparer aux suivants">
                <Path Width="16" Height="16" Data="M4,1.5 H12 V14.5 L8,10.5 L4,14.5 Z" Fill="#E8E8E8" />
            </Button>
            <Button Command="{Binding ClearReferenceCommand}" Style="{StaticResource FA_Icon}" ToolTip="Effacer l'histogramme mémorisé">
                <Path Width="16" Height="16" Data="M2,4 H14 M6,4 V2 H10 V4 M4,4 L5,14.5 H11 L12,4 M7,7 V12 M9,7 V12" Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Rectangle Width="1" Height="20" Margin="4,0,7,3" VerticalAlignment="Center" Fill="#484848" />
            <Button Command="{Binding OpenFileCommand}" Style="{StaticResource FA_Icon}" ToolTip="Ouvrir une image déjà acquise : elle s'affiche dans l'onglet Image, la prochaine pose la remplace">
                <Path Width="16" Height="16" Data="M1,3 H6 L8,5 H15 V14 H1 Z" Fill="#E8E8E8" />
            </Button>
        </WrapPanel>

        <!--  Histogramme, courbe de transfert et curseurs bas / moyen / haut  -->
        <local:HistogramControl
            Grid.Row="4"
            ChannelCurves="{Binding ChannelCurves}"
            CurveChangingCommand="{Binding CurveChangingCommand}"
            CurveCommittedCommand="{Binding CurveCommittedCommand}"
            Highlights="{Binding Highlights, Mode=TwoWay}"
            Histograms="{Binding Histograms}"
            LogScale="{Binding LogScale}"
            Midtone="{Binding Midtone, Mode=TwoWay}"
            Reference="{Binding Reference}"
            ReferenceLabel="{Binding ReferenceLabel}"
            Shadows="{Binding Shadows, Mode=TwoWay}"
            ShowB="{Binding ShowB}"
            ShowOutput="{Binding ShowOutput}"
            ShowColor="{Binding ShowColorCurves}"
            ShowG="{Binding ShowG}"
            ShowR="{Binding ShowR}"
            Smooth="{Binding Smooth}"
            ToolTip="Molette : zoom · glisser : déplacer · clic : valeurs (x ; y) · clic droit : effacer le repère · double clic : tout · triangles sous le tracé : noir, tons moyens, blanc"
            ViewMax="{Binding ViewMax, Mode=TwoWay}"
            ViewMin="{Binding ViewMin, Mode=TwoWay}" />

        <TextBlock Grid.Row="5" Margin="0,2,0,0" FontSize="11" Opacity="0.8" Text="{Binding CurveText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="6" Margin="0,2,0,0" FontSize="11" Opacity="0.7" Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
